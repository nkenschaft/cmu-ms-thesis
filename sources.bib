@article{korbas2006cuplengthbounds,
  title = {Bounds for the cup-length of Poincaré spaces and their applications},
  journal = {Topology and its Applications},
  volume = {153},
  number = {15},
  pages = {2976-2986},
  year = {2006},
  issn = {0166-8641},
  doi = {https://doi.org/10.1016/j.topol.2006.01.005},
  url = {https://www.sciencedirect.com/science/article/pii/S0166864106000149},
  author = {Július Korbaš},
  keywords = {Cup-length, Lyusternik–Shnirel'man (Ljusternik–Schnirelman) category, Poincaré space, Flag manifold},
  abstract = {Our main result offers a new (quite systematic) way of deriving bounds for the cup-length of Poincaré spaces over fields; we outline a general research program based on this result. For the oriented Grassmann manifolds, already a limited realization of the program leads, in many cases, to the exact values of the cup-length and to interesting information on the Lyusternik–Shnirel'man category.}
}

